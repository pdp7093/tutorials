<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        
        <div class="border d-flex align-items-center mb-2 p-2 w-100" >
            <input type="checkbox" t-att-checked="props.todo.isCompleted"
            t-on-click="toggle" />

            <span t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through ms-2':'ms-2'">

                <t t-esc="props.todo.description" />
            </span>

            <button class="btn btn-danger btn-sm ms-3" t-on-click="delete">
                Delete
            </button>
        </div>
    </t>
</templates>