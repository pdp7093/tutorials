<odoo>
    <data>
        <record id="view_estate_property_tree" model='ir.ui.view'>
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list decoration-success ="state =='sold'" decoration-danger="state=='canceled'">
                    <field name="name" />
                    <field name="property_type_id" />
                    <field name="postcode" />
                    <field name="expected_price" />
                    <field name="selling_price" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="view_estate_property_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string='test'>
                    <header>
                        <button name="action_sold"
                            type="object"
                            string="Mark as Sold"
                            class="btn-primary"
                            invisible="state != 'offer_accepted'" />

                        <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state in ['sold','canceled']" />

                        <field name="state" widget="statusbar"
                            statusbar_visible="new,offer_received,offer_accepted,sold,canceled" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_offers"
                                type="object" class="oe_stat_button" icon="fa-list">
                                <field name="offer_count" widget="statinfo" string="Offers" />
                            </button>
                        </div>
                        <group>
                            <field name="name" />
                            <field name="property_type_id" />
                        </group>
                        <group>
                            <group>
                                <field name="buyer_id" readonly="1" />
                            </group>
                            <group>
                                <field name="seller_id" />
                            </group>

                        </group>
                        <group>
                            <group>
                                <field name="expected_price" readonly="state in ['sold','canceled']" />
                                <field name="selling_price" readonly="1" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}" />
                                <field name="active" />
                            </group>
                            <group>
                                <field name="date_availability" />

                                <field name="postcode" />
                                <field name="garden" />
                                <field name="garden_area" invisible="not garden" />
                                <field name="garden_orientation" invisible="not garden" />
                                <field name="total_area" readonly="1" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" />
                            </page>

                            <page string="Offers">
                                <field name="offer_ids" context="{'default_property_id': id}">

                                    <list>
                                        <field name="price" />
                                        <field name="partner_id" />
                                        <field name="validity" />
                                        <field name="date_deadline" />
                                        <button name="action_accept"
                                            type="object"
                                            icon="fa-check"
                                            attrs="{'invisible': [('status','!=',False)]}" />

                                        <button name="action_refuse"
                                            type="object"
                                            icon="fa-times"
                                            attrs="{'invisible': [('status','!=',False)]}" />

                                        <field name="status" />
                                    </list>

                                    <form>
                                        <header>
                                            <button name="action_accept"
                                                type="object"
                                                string="Accept"
                                                class="btn-primary" />

                                            <button name="action_refuse"
                                                type="object"
                                                string="Refuse"
                                                class="btn-secondary" />

                                            <field name="status" widget="statusbar" />
                                        </header>

                                        <sheet>
                                            <group>
                                                <field name="price" />
                                                <field name="partner_id" />
                                                <field name="validity" />
                                                <field name="date_deadline" />
                                            </group>
                                        </sheet>
                                    </form>

                                </field>
                            </page>
                            <page string="Additional Info">
                                <group>
                                    <field name="buyer_id" readonly="1" />
                                    <field name="selling_price" readonly="1" />
                                </group>
                            </page>

                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <!-- Start of view_estate_property_offer_tree -->
        <record id="view_estate_property_offer_tree" model="ir.ui.view">
            <field name="name">estate.property.offer.tree</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="price" />
                    <field name="partner_id" />
                    <field name="validity" />
                    <field name="date_deadline" />
                    <field name="status" />
                </list>
            </field>
        </record>
        <!-- End of view_estate_property_offer_tree -->
    </data>

</odoo>