<odoo>
    <data>
        <record id="view_estate_property_tree" model='ir.ui.view'>
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="property_type_id" />
                    <field name="postcode" />
                    <field name="expected_price" />
                    <field name="selling_price" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="view_estate_property_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string='test'>
                    <header>
                        <button name="action_sold"
                            type="object"
                            string="Mark as Sold"
                            class="btn-primary" />

                        <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary" />
                    </header>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="property_type_id" />
                        </group>
                        <group>
                            <group>
                                <field name="buyer_id" readonly="1" />
                            </group>
                            <group>
                                <field name="seller_id" />
                            </group>

                        </group>
                        <group>
                            <group>
                                <field name="expected_price" />
                                <field name="selling_price" readonly="1" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="tag_ids" widget="many2many_tags" />
                                <field name="active" />
                            </group>
                            <group>
                                <field name="date_availability" />
                                <field name="state" readonly="1" />
                                <field name="postcode" />
                                <field name="garden" />
                                <field name="garden_area" />
                                <field name="garden_orientation" />
                                <field name="total_area" readonly="1" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" />
                            </page>

                            <page string="Offers">
                                <field name="offer_ids" context="{'default_property_id': id}">

                                    <list>
                                        <field name="price" />
                                        <field name="partner_id" />
                                        <field name="validity" />
                                        <field name="date_deadline" />
                                        <button name="action_accept"
                                            type="object"
                                            icon="fa-check"
                                            attrs="{'invisible': [('status','!=',False)]}" />

                                        <button name="action_refuse"
                                            type="object"
                                            icon="fa-times"
                                            attrs="{'invisible': [('status','!=',False)]}" />

                                        <field name="status" />
                                    </list>

                                    <form>
                                        <header>
                                            <button name="action_accept"
                                                type="object"
                                                string="Accept"
                                                class="btn-primary" />

                                            <button name="action_refuse"
                                                type="object"
                                                string="Refuse"
                                                class="btn-secondary" />

                                            <field name="status" widget="statusbar" />
                                        </header>

                                        <sheet>
                                            <group>
                                                <field name="price" />
                                                <field name="partner_id" />
                                                <field name="validity" />
                                                <field name="date_deadline" />
                                            </group>
                                        </sheet>
                                    </form>

                                </field>
                            </page>
                            <page string="Additional Info">
                                <group>
                                    <field name="buyer_id" readonly="1" />
                                    <field name="selling_price" readonly="1" />
                                </group>
                            </page>

                        </notebook>
                    </sheet>


                </form>
            </field>
        </record>
    </data>

</odoo>